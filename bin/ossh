#!/bin/sh
# ossh - ssh with automatic OSC 52 -> local clipboard bridging.
#
# Every copy made inside the remote session (OpenCode, vim, tmux, ...) lands in
# the clipboard of *this* machine, even if the terminal emulator does not
# implement OSC 52.
#
# Usage:
#   ossh [ssh options] [user@]host [command...]
#
# The clipboard tool is auto-detected. Override it with OSSH_CLIP_CMD:
#   OSSH_CLIP_CMD='xclip -selection clipboard -i' ossh host

set -eu

if [ -n "${OSSH_CLIP_CMD:-}" ]; then
    clip=$OSSH_CLIP_CMD
elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    clip=wl-copy
elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then
    clip='xclip -selection clipboard -i'
elif command -v wl-copy >/dev/null 2>&1; then
    clip=wl-copy
elif command -v xclip >/dev/null 2>&1; then
    clip='xclip -selection clipboard -i'
elif command -v pbcopy >/dev/null 2>&1; then
    clip=pbcopy
elif command -v clip.exe >/dev/null 2>&1; then
    clip=clip.exe
else
    echo "ossh: no clipboard tool found; install wl-clipboard or xclip," >&2
    echo "      or set OSSH_CLIP_CMD to a command that reads stdin" >&2
    exit 1
fi

if ! command -v osc52-tee >/dev/null 2>&1; then
    echo "ossh: osc52-tee not found in PATH" >&2
    exit 1
fi

exec osc52-tee --copy-command "$clip" --no-log --no-stream -- ssh "$@"
